# Normalize line endings: LF in the repo and on disk, so Windows edits don't
# rewrite whole files (CI and the data workflow run on Linux).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.parquet binary
*.duckdb binary
*.zip binary
