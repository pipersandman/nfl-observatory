# Copy to .env (never commit .env) and fill in values from Bitwarden.
# Only add a value when its plan step needs it locally. GitHub Actions uses
# repository secrets with the same names.

# V2.0 step 1: Cloudflare R2 raw capture
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# #164: Cloudflare Web Analytics export (GitHub Actions secrets; only needed
# locally to run scripts/analytics_export.py by hand). Token: Account Analytics Read.
# The site tag isn't secret; it's set in .github/workflows/analytics-export.yml.
# CF_ANALYTICS_TOKEN=
# CF_ACCOUNT_ID=
# CF_WEB_ANALYTICS_SITE_TAG=

# Q0 item 1: odds data provider
# ODDS_API_KEY=

# V2.1: error monitoring (public DSN, safe in the site but kept here for scripts)
# SENTRY_DSN=

# V2.3: Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# V2.4: Ask the Observatory (separate from your Claude plan; set a spend limit)
# ANTHROPIC_API_KEY=

# Deploy credentials (FTP_SERVER, FTP_USERNAME, FTP_PASSWORD, FTP_SERVER_DIR)
# live only in GitHub Actions secrets. Not needed on the laptop.
